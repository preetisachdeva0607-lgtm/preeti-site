/* Floating WhatsApp Channel Badge */
.wa-channel-float {
  position: fixed;
  bottom: 100px;
  left: 30px;
  z-index: 999;
  background: linear-gradient(135deg, #075E54, #128C7E);
  color: #fff;
  padding: 10px 18px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 15px rgba(7,94,84,0.4);
  transition: all 0.4s cubic-bezier(0.22,1,0.36,1);
  opacity: 0;
  transform: translateX(-100px);
}
.wa-channel-float.visible {
  opacity: 1;
  transform: translateX(0);
}
.wa-channel-float:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(7,94,84,0.5);
}
.wa-channel-float .wa-float-close {
  background: rgba(255,255,255,0.2);
  border: none;
  color: #fff;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  font-size: 12px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 4px;
  transition: background 0.3s;
}
.wa-channel-float .wa-float-close:hover {
  background: rgba(255,255,255,0.35);
}
@media (max-width: 600px) {
  .wa-channel-float {
    bottom: 80px;
    left: 15px;
    font-size: 12px;
    padding: 8px 14px;
  }
}
</style>
</head>
