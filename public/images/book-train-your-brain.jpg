<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --primary: #0D9488;
  --primary-light: #2DD4BF;
  --primary-dark: #065F56;
  --accent: #F97316;
  --accent-light: #FB923C;
  --bg: #F0FDFA;
  --bg-alt: #E6FFFA;
  --text: #2D2A32;
  --text-light: #6B6572;
  --white: #FFFFFF;
  --shadow: 0 4px 20px rgba(13,148,136,0.1);
  --shadow-lg: 0 8px 40px rgba(13,148,136,0.15);
  --pink-accent: #EC4899;
  --blue-accent: #06B6D4;
  --glass-bg: rgba(255,255,255,0.7);
  --glass-border: rgba(255,255,255,0.3);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', sans-serif;
  color: var(--text);
  background: var(--bg);
  line-height: 1.7;
  overflow-x: hidden;
}

/* Gradient Mesh Background */
body::before {
  content: '';
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  z-index: -2;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(13,148,136,0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(224,107,159,0.05) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(123,140,222,0.05) 0%, transparent 50%);
  animation: meshMove 20s ease-in-out infinite alternate;
}
@keyframes meshMove {
  0% { transform: scale(1) translate(0,0); }
  50% { transform: scale(1.05) translate(-2%,1%); }
  100% { transform: scale(1) translate(1%,-1%); }
}

/* Scroll Animations */
.scroll-animate {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1);
}
.scroll-animate.visible {
  opacity: 1;
  transform: translateY(0);
}
.scroll-animate-left {
  opacity: 0;
  transform: translateX(-40px);
  transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1);
}
.scroll-animate-left.visible {
  opacity: 1;
  transform: translateX(0);
}
.scroll-animate-right {
  opacity: 0;
  transform: translateX(40px);
  transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1);
}
.scroll-animate-right.visible {
  opacity: 1;
  transform: translateX(0);
}

/* Gradient Text for Section Headers */
.gradient-text {
  background: linear-gradient(135deg, #0D9488 0%, #06B6D4 50%, #2DD4BF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Floating Hero Shapes */
.hero-shapes {
  position: absolute; inset: 0; overflow: hidden; z-index: 0; pointer-events: none;
}
.hero-shape {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
  animation: floatShape 8s ease-in-out infinite;
}
.hero-shape:nth-child(1) {
  width: 300px; height: 300px;
  background: radial-gradient(circle, var(--primary-light), transparent);
  top: -80px; right: 10%;
  animation-duration: 10s;
}
.hero-shape:nth-child(2) {
  width: 200px; height: 200px;
  background: radial-gradient(circle, var(--pink-accent), transparent);
  bottom: 10%; left: 5%;
  animation-duration: 12s; animation-delay: -3s;
}
.hero-shape:nth-child(3) {
  width: 150px; height: 150px;
  background: radial-gradient(circle, var(--accent), transparent);
  top: 30%; left: 40%;
  animation-duration: 9s; animation-delay: -5s;
}
.hero-shape:nth-child(4) {
  width: 80px; height: 80px;
  background: radial-gradient(circle, var(--blue-accent), transparent);
  top: 20%; right: 30%;
  animation-duration: 7s; animation-delay: -2s;
}
.hero-shape:nth-child(5) {
  width: 120px; height: 120px;
  background: radial-gradient(circle, var(--primary), transparent);
  bottom: 20%; right: 20%;
  animation-duration: 11s; animation-delay: -4s;
}
@keyframes floatShape {
  0%, 100% { transform: translate(0,0) scale(1); }
  33% { transform: translate(15px,-20px) scale(1.05); }
  66% { transform: translate(-10px,15px) scale(0.95); }
}

h1, h2, h3, h4 { font-family: 'Playfair Display', serif; }

/* Navigation */
nav {
  position: fixed; top: 0; width: 100%; z-index: 1000;
  background: rgba(253,251,247,0.8);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(13,148,136,0.08);
  padding: 15px 0;
  transition: all 0.3s;
}
.nav-container {
  max-width: 1200px; margin: 0 auto; padding: 0 30px;
  display: flex; justify-content: space-between; align-items: center;
}
.logo {
  font-family: 'Playfair Display', serif;
  font-size: 22px; font-weight: 700; color: var(--primary);
  text-decoration: none;
}
.logo span { color: var(--accent); }
.nav-links { display: flex; gap: 30px; list-style: none; }
.nav-links a {
  text-decoration: none; color: var(--text-light);
  font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
  text-transform: uppercase; transition: color 0.3s;
}
.nav-links a:hover { color: var(--primary); }
.hamburger { display: none; cursor: pointer; font-size: 24px; color: var(--primary); }

/* Hero Section */
.hero {
  min-height: 100vh;
  display: flex; align-items: center;
  background: linear-gradient(135deg, var(--bg) 0%, var(--bg-alt) 40%, #CCFBF1 70%, #B2F5EA 100%);
  padding: 140px 30px 100px;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: ''; position: absolute; top: -50%; right: -20%;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(13,148,136,0.08) 0%, transparent 70%);
  border-radius: 50%;
}
.hero::after {
  content: ''; position: absolute; bottom: -30%; left: -10%;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(249,115,22,0.08) 0%, transparent 70%);
  border-radius: 50%;
}
.hero-container {
  max-width: 1200px; margin: 0 auto; width: 100%;
  display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  position: relative; z-index: 1;
}
.hero-text h1 {
  font-size: 56px; line-height: 1.15; color: var(--primary-dark);
  margin-bottom: 12px;
}
.hero-text .tagline {
  font-size: 20px; color: var(--primary-light); font-weight: 400;
  margin-bottom: 20px; font-family: 'Playfair Display', serif; font-style: italic;
}
.hero-text p {
  font-size: 17px; color: var(--text-light); margin-bottom: 30px;
  max-width: 500px; text-align: center; margin-left: auto; margin-right: auto;
}
.hero-badges {
  display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px;
}
.badge {
  background: var(--white); border: 1px solid rgba(13,148,136,0.15);
  padding: 6px 16px; border-radius: 50px; font-size: 13px;
  color: var(--primary); font-weight: 500;
}
.hero-buttons { display: flex; gap: 15px; flex-wrap: wrap; }
.btn {
  display: inline-block; padding: 14px 32px; border-radius: 50px;
  text-decoration: none; font-weight: 600; font-size: 15px;
  transition: all 0.3s; cursor: pointer; border: none;
}
.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--white);
  box-shadow: 0 4px 15px rgba(13,148,136,0.3);
}
.btn-primary:hover {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
  box-shadow: 0 8px 30px rgba(13,148,136,0.4);
  transform: translateY(-3px);
}
.btn-outline {
  background: transparent; color: var(--primary);
  border: 2px solid var(--primary);
}
.btn-outline:hover {
  background: var(--primary); color: var(--white);
}
.hero-image {
  display: flex; justify-content: center; align-items: center;
}
.hero-photo {
  width: 340px; height: 340px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-lg);
  position: relative;
  overflow: hidden;
}
.hero-photo::after {
  content: ''; position: absolute; inset: -15px;
  border: 2px dashed var(--primary-light); border-radius: 50%;
  animation: spin 30s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* Stats */
.stats {
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 60px 30px;
  box-shadow: var(--shadow);
}
.stats-container {
  max-width: 1000px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(5, 1fr); gap: 30px;
  text-align: center;
}
.stat h3 {
  font-size: 42px; color: var(--primary);
  margin-bottom: 5px;
}
.stat p { font-size: 14px; color: var(--text-light); font-weight: 500; text-transform: uppercase; letter-spacing: 1px; }

/* Section Styles */
.section {
  padding: 100px 30px;
}
.section-alt { background: var(--bg-alt); }
.section-header {
  text-align: center; margin-bottom: 50px;
}
.section-header h2 {
  font-size: 38px; color: var(--primary-dark); margin-bottom: 10px;
  background: linear-gradient(135deg, #0D9488 0%, #06B6D4 60%, #2DD4BF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.section-header p {
  font-size: 17px; color: var(--text-light); max-width: 600px; margin: 0 auto;
}
.section-header .divider {
  width: 60px; height: 3px; background: var(--accent);
  margin: 15px auto 0; border-radius: 2px;
}

/* About */
.about-grid {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center;
}
.about-text p { margin-bottom: 15px; font-size: 16px; color: var(--text-light); }
.about-text strong { color: var(--text); }

/* Services */
.services-grid {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px;
}
.service-card {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 16px; padding: 35px 25px;
  text-align: center;
  box-shadow: var(--shadow);
  transition: all 0.4s cubic-bezier(0.22,1,0.36,1);
  border: 1px solid var(--glass-border);
}
.service-card:hover {
  transform: translateY(-8px);
  border-color: var(--primary-light);
  box-shadow: 0 8px 40px rgba(13,148,136,0.2), 0 0 20px rgba(13,148,136,0.08);
}
.service-icon {
  font-size: 40px; margin-bottom: 15px;
}
.service-card h3 {
  font-size: 20px; color: var(--primary-dark); margin-bottom: 10px;
}
.service-card p { font-size: 14px; color: var(--text-light); }

/* Awards */
.awards-grid {
  max-width: 900px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
}
.award-item {
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid var(--glass-border);
  border-radius: 12px; padding: 20px 25px;
  display: flex; align-items: flex-start; gap: 15px;
  box-shadow: var(--shadow); transition: all 0.4s cubic-bezier(0.22,1,0.36,1);
}
.award-item:hover { transform: translateY(-5px); box-shadow: 0 8px 30px rgba(13,148,136,0.18); }
.award-icon { font-size: 28px; flex-shrink: 0; }
.award-item p { font-size: 14px; color: var(--text-light); }
.award-item strong { color: var(--text); font-size: 15px; }

/* Certifications */
.cert-list {
  max-width: 800px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
}
.cert-item {
  background: var(--glass-bg);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid var(--glass-border);
  border-radius: 10px; padding: 15px 20px;
  display: flex; align-items: center; gap: 12px;
  font-size: 14px; color: var(--text-light);
  border-left: 3px solid var(--accent);
  transition: all 0.3s;
}
.cert-item:hover {
  transform: translateX(5px);
  box-shadow: var(--shadow);
}
.cert-item span { font-size: 18px; }

/* Gallery */
.gallery-grid {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
}
.gallery-item {
  position: relative; border-radius: 12px; overflow: hidden;
  cursor: pointer; aspect-ratio: 1; box-shadow: var(--shadow);
  transition: transform 0.3s;
}
.gallery-item:hover { transform: scale(1.05); box-shadow: 0 8px 30px rgba(13,148,136,0.25); }
.gallery-item img, .gallery-item video {
  width: 100%; height: 100%; object-fit: cover;
}
.gallery-item.wide { grid-column: span 2; aspect-ratio: 2/1; }
.gallery-item.tall { grid-row: span 2; aspect-ratio: auto; }
.gallery-overlay {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: linear-gradient(transparent, rgba(6,95,86,0.8));
  color: white; padding: 12px 15px; font-size: 12px; font-weight: 500;
}
.gallery-play {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 60px; height: 60px; background: rgba(255,255,255,0.9);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 24px; color: var(--primary); box-shadow: 0 4px 15px rgba(0,0,0,0.3);
}
/* Lightbox */
.lightbox {
  display: none; position: fixed; inset: 0; z-index: 9999;
  background: rgba(0,0,0,0.92); align-items: center; justify-content: center;
  padding: 20px;
}
.lightbox.active { display: flex; }
.lightbox img, .lightbox video {
  max-width: 90vw; max-height: 85vh; border-radius: 10px;
  object-fit: contain;
}
.lightbox-close {
  position: absolute; top: 20px; right: 30px;
  color: white; font-size: 36px; cursor: pointer;
  background: none; border: none; z-index: 10000;
}
.lightbox-nav {
  position: absolute; top: 50%; transform: translateY(-50%);
  color: white; font-size: 40px; cursor: pointer;
  background: rgba(255,255,255,0.1); border: none;
  padding: 10px 18px; border-radius: 50%;
  transition: background 0.3s;
}
.lightbox-nav:hover { background: rgba(255,255,255,0.25); }
.lightbox-prev { left: 20px; }
.lightbox-next { right: 20px; }
.lightbox-caption {
  position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
  color: white; font-size: 14px; background: rgba(0,0,0,0.5);
  padding: 8px 20px; border-radius: 20px; white-space: nowrap;
}
@media (max-width: 768px) {
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-item.wide { grid-column: span 2; }
  .gallery-item.tall { grid-row: span 1; aspect-ratio: 1; }
}

/* Book */
.book-section {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
  padding: 80px 30px; color: var(--white);
}
.book-container {
  max-width: 900px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: center;
}
.book-cover {
  background: var(--white); border-radius: 8px; padding: 20px;
  text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.3);
  transform: rotate(-3deg); transition: transform 0.3s;
}
.book-cover:hover { transform: rotate(0deg); }
.book-emoji { font-size: 80px; }
.book-cover h4 { color: var(--primary-dark); font-size: 18px; margin-top: 10px; }
.book-info h2 { font-size: 34px; margin-bottom: 15px; color: var(--white); }
.book-info p { font-size: 16px; opacity: 0.9; margin-bottom: 20px; }
.btn-accent {
  background: var(--accent); color: var(--primary-dark); font-weight: 700;
  box-shadow: 0 4px 15px rgba(249,115,22,0.4);
}
.btn-accent:hover {
  background: var(--accent-light); transform: translateY(-2px);
}

/* Testimonials */
/* Google Rating Banner */
.rating-banner {
  text-align: center; padding: 20px; margin-bottom: 30px;
}
.rating-banner .big-rating {
  font-family: 'Playfair Display', serif;
  font-size: 56px; font-weight: 700; color: var(--primary-dark);
  line-height: 1;
}
.rating-banner .big-stars { font-size: 28px; color: var(--accent); margin: 8px 0; }
.rating-banner .rating-meta { font-size: 14px; color: var(--text-light); }
.rating-banner .rating-meta span { margin: 0 12px; }
.google-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--white); border: 1px solid rgba(13,148,136,0.15);
  padding: 8px 20px; border-radius: 50px; margin-top: 12px;
  font-size: 13px; font-weight: 500; color: var(--text);
  box-shadow: var(--shadow);
}
.google-badge img { width: 18px; height: 18px; }

/* Testimonials Carousel */
.carousel-wrapper {
  max-width: 1100px; margin: 0 auto; position: relative; overflow: hidden;
}
.carousel-track {
  display: flex; gap: 25px;
  animation: scroll 30s linear infinite;
  width: max-content;
}
.carousel-track:hover { animation-play-state: paused; }
@keyframes scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.testimonial-card {
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid var(--glass-border);
  border-radius: 16px; padding: 30px;
  box-shadow: var(--shadow); position: relative;
  min-width: 320px; max-width: 350px; flex-shrink: 0;
  transition: all 0.3s;
}
.testimonial-card:hover {
  box-shadow: 0 8px 30px rgba(13,148,136,0.18);
  border-color: var(--primary-light);
}
.testimonial-card::before {
  content: '"'; font-family: 'Playfair Display', serif;
  font-size: 60px; color: var(--primary-light); opacity: 0.3;
  position: absolute; top: 10px; left: 20px;
}
.testimonial-card p { font-size: 14px; color: var(--text-light); font-style: italic; margin-bottom: 15px; padding-top: 20px; }
.testimonial-author { font-weight: 600; font-size: 14px; color: var(--primary); }
.stars { color: var(--accent); font-size: 13px; margin-top: 3px; }
.review-cta {
  text-align: center; margin-top: 35px;
}
.review-cta a {
  display: inline-block; padding: 12px 30px; border-radius: 50px;
  background: var(--white); border: 2px solid var(--primary);
  color: var(--primary); font-weight: 600; font-size: 14px;
  text-decoration: none; transition: all 0.3s;
}
.review-cta a:hover { background: var(--primary); color: var(--white); }

/* Blog */
.blog-grid {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 25px;
}
.blog-card {
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid var(--glass-border);
  border-radius: 16px; overflow: hidden;
  box-shadow: var(--shadow); transition: all 0.4s cubic-bezier(0.22,1,0.36,1); cursor: pointer;
}
.blog-card:hover { transform: translateY(-8px); box-shadow: 0 12px 40px rgba(13,148,136,0.2); border-color: var(--primary-light); }
.blog-card-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  padding: 30px 25px; color: var(--white); position: relative;
}
.blog-card-header .blog-icon { font-size: 40px; margin-bottom: 10px; }
.blog-card-header h3 { font-size: 20px; line-height: 1.3; }
.blog-card-header .blog-tag {
  display: inline-block; background: rgba(255,255,255,0.2);
  padding: 4px 12px; border-radius: 20px; font-size: 11px;
  font-family: 'Inter', sans-serif; margin-top: 10px; font-weight: 500;
}
.blog-card-body { padding: 20px 25px; }
.blog-card-body p { font-size: 14px; color: var(--text-light); line-height: 1.7; }
.blog-card-footer {
  padding: 15px 25px; border-top: 1px solid rgba(13,148,136,0.1);
  display: flex; justify-content: space-between; align-items: center;
}
.blog-card-footer .author { font-size: 12px; color: var(--primary); font-weight: 600; }
.blog-card-footer .read-more {
  font-size: 13px; color: var(--primary); font-weight: 600;
  text-decoration: none; transition: color 0.3s;
}
.blog-card-footer .read-more:hover { color: var(--accent); }

/* Blog Expandable Posts */
.blog-full {
  display: none; padding: 30px 25px 25px;
  border-top: 1px solid rgba(13,148,136,0.1);
}
.blog-full.active { display: block; }
.blog-full h2 {
  font-size: 24px; color: var(--primary-dark); margin-bottom: 5px;
}
.blog-full .blog-meta {
  font-size: 13px; color: var(--primary-light); margin-bottom: 20px;
  font-style: italic;
}
.blog-full .blog-body { font-size: 15px; color: var(--text); line-height: 1.9; }
.blog-full .blog-body p { margin-bottom: 15px; }
.blog-full .blog-body .dialogue {
  font-style: italic; color: var(--primary-dark); margin-left: 20px;
  border-left: 3px solid var(--accent); padding-left: 15px;
  margin-bottom: 10px;
}
.blog-full .blog-quote {
  text-align: center; font-family: 'Playfair Display', serif;
  font-size: 18px; color: var(--primary); font-style: italic;
  margin: 25px 0; padding: 20px;
  border-top: 2px solid var(--accent); border-bottom: 2px solid var(--accent);
}
.blog-full .blog-author {
  text-align: right; font-size: 14px; color: var(--primary);
  font-weight: 600; margin-top: 20px;
}
.blog-collapse-btn {
  display: block; margin: 15px auto 0; padding: 10px 25px;
  background: var(--primary); color: white; border: none;
  border-radius: 25px; font-size: 13px; font-weight: 600;
  cursor: pointer; transition: all 0.3s;
}
.blog-collapse-btn:hover { background: var(--primary-dark); }

/* Contact */
.contact-grid {
  max-width: 900px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
}
.contact-info { display: flex; flex-direction: column; gap: 20px; }
.contact-item {
  display: flex; align-items: center; gap: 15px;
  font-size: 16px;
}
.contact-item span { font-size: 28px; }
.contact-form {
  display: flex; flex-direction: column; gap: 15px;
}
.contact-form input, .contact-form textarea {
  padding: 14px 18px; border: 1px solid rgba(13,148,136,0.2);
  border-radius: 10px; font-family: 'Inter', sans-serif;
  font-size: 14px; background: var(--white);
  transition: border-color 0.3s; outline: none;
}
.contact-form input:focus, .contact-form textarea:focus {
  border-color: var(--primary);
}
.contact-form textarea { height: 120px; resize: vertical; }

/* Footer */
footer {
  background: var(--primary-dark); color: var(--white);
  padding: 40px 30px; text-align: center;
}
footer p { opacity: 0.7; font-size: 14px; }
footer .social-links { margin-bottom: 15px; }
footer .social-links a {
  color: var(--white); text-decoration: none; margin: 0 10px;
  font-size: 22px; opacity: 0.7; transition: opacity 0.3s;
}
footer .social-links a:hover { opacity: 1; }

/* Responsive */
@media (max-width: 768px) {
  .hero-container { grid-template-columns: 1fr; text-align: center; }
  .hero-text h1 { font-size: 38px; }
  .hero-text p, .hero-badges { justify-content: center; }
  .hero-image { order: -1; }
  .hero-photo { width: 220px; height: 220px; font-size: 80px; }
  .stats-container { grid-template-columns: repeat(2, 1fr); }
  .about-grid, .contact-grid { grid-template-columns: 1fr; }
  .services-grid { grid-template-columns: 1fr; }
  .awards-grid { grid-template-columns: 1fr; }
  .cert-list { grid-template-columns: 1fr; }
  .testimonials-grid { grid-template-columns: 1fr; }
  .book-container { grid-template-columns: 1fr; text-align: center; }
  .nav-links { display: none; }
  .hamburger { display: block; }
  .nav-links.active {
    display: flex; flex-direction: column;
    position: absolute; top: 60px; left: 0; right: 0;
    background: var(--bg); padding: 20px;
    box-shadow: var(--shadow);
  }
  .hero-buttons { justify-content: center; }
  .section-header h2 { font-size: 28px; }
  .media-podcast-grid { grid-template-columns: 1fr !important; }
  .featured-scroll-track { animation-duration: 15s !important; }
}

/* Featured In / Media Section */
.featured-scroll {
  overflow: hidden;
  padding: 20px 0;
  position: relative;
}
.featured-scroll::before,
.featured-scroll::after {
  content: '';
  position: absolute;
  top: 0; bottom: 0;
  width: 80px;
  z-index: 2;
  pointer-events: none;
}
.featured-scroll::before {
  left: 0;
  background: linear-gradient(to right, var(--bg-alt), transparent);
}
.featured-scroll::after {
  right: 0;
  background: linear-gradient(to left, var(--bg-alt), transparent);
}
.featured-scroll-track {
  display: flex;
  gap: 20px;
  width: max-content;
  animation: featuredScroll 25s linear infinite;
}
.featured-scroll-track:hover {
  animation-play-state: paused;
}
@keyframes featuredScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.featured-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 22px;
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid var(--glass-border);
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  color: var(--primary-dark);
  white-space: nowrap;
  box-shadow: 0 2px 10px rgba(13,148,136,0.08);
  transition: all 0.3s;
  flex-shrink: 0;
}
.featured-pill:hover {
  border-color: var(--primary-light);
  box-shadow: 0 4px 20px rgba(13,148,136,0.15);
  transform: translateY(-2px);
}
.featured-pill .pill-icon {
  font-size: 18px;
}

/* Media Podcast Cards */
.media-podcast-grid {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 25px;
}
.media-card {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: all 0.4s cubic-bezier(0.22,1,0.36,1);
}
.media-card:hover {
  transform: translateY(-8px);
  border-color: var(--primary-light);
  box-shadow: 0 12px 40px rgba(13,148,136,0.2);
}
.media-card-img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  display: block;
}
.media-card-body {
  padding: 20px;
}
.media-card-tag {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  margin-bottom: 10px;
  letter-spacing: 0.5px;
}
.media-card-tag.podcast {
  background: rgba(13,148,136,0.1);
  color: var(--primary);
}
.media-card-tag.featured {
  background: rgba(249,115,22,0.1);
  color: var(--accent);
}
.media-card-body h3 {
  font-size: 17px;
  color: var(--primary-dark);
  margin-bottom: 8px;
  line-height: 1.3;
}
.media-card-body p {
  font-size: 13px;
  color: var(--text-light);
  line-height: 1.6;
}

/* Media Stats Banner */
.media-stats-banner {
  max-width: 900px;
  margin: 50px auto 0;
  background: linear-gradient(135deg, var(--primary) 0%, #06B6D4 50%, var(--primary-light) 100%);
  border-radius: 16px;
  padding: 30px 40px;
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 20px;
  color: #fff;
  text-align: center;
  box-shadow: 0 8px 30px rgba(13,148,136,0.25);
}
.media-stats-banner .m-stat {
  flex: 1;
  min-width: 120px;
}
.media-stats-banner .m-stat .m-num {
  font-family: 'Playfair Display', serif;
  font-size: 32px;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 4px;
}
.media-stats-banner .m-stat .m-label {
  font-size: 13px;
  opacity: 0.9;
  font-weight: 500;
}

/* Wall of Fame */
.wof-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  max-width: 1100px;
  margin: 0 auto;
}
.wof-card {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  padding: 30px 25px 25px;
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}
.wof-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 16px 50px rgba(13,148,136,0.2);
}
.wof-card .wof-sparkle {
  position: absolute;
  top: 10px;
  right: 14px;
  font-size: 22px;
  opacity: 0.5;
  animation: wofTwinkle 2s ease-in-out infinite alternate;
}
@keyframes wofTwinkle {
  0% { opacity: 0.3; transform: scale(0.9); }
  100% { opacity: 0.8; transform: scale(1.15); }
}
.wof-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 15px;
  font-size: 28px;
  font-weight: 700;
  color: #fff;
  font-family: 'Playfair Display', serif;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15);
}
.wof-avatar.av-teal { background: linear-gradient(135deg, #0D9488, #2DD4BF); }
.wof-avatar.av-coral { background: linear-gradient(135deg, #F97316, #FB923C); }
.wof-avatar.av-blue { background: linear-gradient(135deg, #3B82F6, #60A5FA); }
.wof-avatar.av-pink { background: linear-gradient(135deg, #EC4899, #F472B6); }
.wof-avatar.av-gold { background: linear-gradient(135deg, #D97706, #FBBF24); }
.wof-name {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 6px;
}
.wof-age {
  display: inline-block;
  background: var(--bg-alt);
  color: var(--primary-dark);
  font-size: 12px;
  font-weight: 600;
  padding: 3px 12px;
  border-radius: 20px;
  margin-bottom: 10px;
}
.wof-category {
  display: inline-block;
  font-size: 13px;
  font-weight: 600;
  padding: 5px 14px;
  border-radius: 20px;
  margin-bottom: 14px;
  color: #fff;
}
.wof-category.cat-teal { background: var(--primary); }
.wof-category.cat-coral { background: var(--accent); }
.wof-category.cat-blue { background: #3B82F6; }
.wof-category.cat-pink { background: #EC4899; }
.wof-category.cat-gold { background: #D97706; }
.wof-desc {
  font-size: 14px;
  color: var(--text-light);
  line-height: 1.7;
  margin-bottom: 12px;
}
.wof-stars {
  color: #FBBF24;
  font-size: 18px;
  letter-spacing: 3px;
}
.wof-cta {
  text-align: center;
  margin-top: 50px;
}
.wof-cta h3 {
  font-family: 'Playfair Display', serif;
  font-size: 26px;
  color: var(--text);
  margin-bottom: 18px;
}
.wof-cta a {
  display: inline-block;
  background: linear-gradient(135deg, #25D366, #128C7E);
  color: #fff;
  padding: 14px 32px;
  border-radius: 50px;
  font-weight: 600;
  text-decoration: none;
  font-size: 16px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.wof-cta a:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(37,211,102,0.35);
}
@media (max-width: 900px) {
  .wof-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .wof-grid { grid-template-columns: 1fr; }
  .wof-cta h3 { font-size: 22px; }
}

/* WhatsApp Community Section */
.wa-community {
  background: linear-gradient(135deg, #065F56 0%, #0D9488 40%, #06B6D4 100%);
  padding: 100px 30px;
  position: relative;
  overflow: hidden;
  color: #fff;
}
.wa-community::before {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 300px; height: 300px;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
}
.wa-community::after {
  content: '';
  position: absolute;
  bottom: -80px; left: -40px;
  width: 250px; height: 250px;
  background: rgba(255,255,255,0.03);
  border-radius: 50%;
}
.wa-community .wa-inner {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 1;
}
.wa-community .wa-emoji-big {
  font-size: 60px;
  margin-bottom: 15px;
  display: block;
  animation: floatShape 4s ease-in-out infinite;
}
.wa-community .wa-title {
  font-family: 'Playfair Display', serif;
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 12px;
  color: #fff;
  -webkit-text-fill-color: #fff;
}
.wa-community .wa-subtitle {
  font-size: 17px;
  opacity: 0.92;
  max-width: 600px;
  margin: 0 auto 35px;
  line-height: 1.7;
}
.wa-benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 35px;
}
.wa-benefit {
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 14px;
  padding: 20px 16px;
  text-align: center;
  transition: all 0.3s;
}
.wa-benefit:hover {
  background: rgba(255,255,255,0.18);
  transform: translateY(-4px);
}
.wa-benefit .wa-b-icon {
  font-size: 28px;
  margin-bottom: 8px;
  display: block;
}
.wa-benefit .wa-b-text {
  font-size: 14px;
  font-weight: 500;
  opacity: 0.95;
}
.wa-join-btn {
  display: inline-block;
  padding: 18px 45px;
  background: #25D366;
  color: #fff;
  font-size: 18px;
  font-weight: 700;
  border-radius: 50px;
  text-decoration: none;
  box-shadow: 0 6px 25px rgba(37,211,102,0.45);
  transition: all 0.3s;
  border: none;
  cursor: pointer;
}
.wa-join-btn:hover {
  background: #20bd5a;
  transform: translateY(-3px);
  box-shadow: 0 10px 35px rgba(37,211,102,0.55);
}
.wa-trust {
  font-size: 14px;
  opacity: 0.8;
  margin-top: 14px;
}
.wa-members {
  display: inline-block;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  padding: 8px 20px;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 25px;
}
/* Chat bubble decoration */
.wa-bubble {
  position: absolute;
  background: rgba(255,255,255,0.06);
  border-radius: 20px 20px 20px 4px;
  padding: 14px 22px;
  font-size: 13px;
  opacity: 0.5;
  pointer-events: none;
}
.wa-bubble.b1 { top: 15%; left: 5%; width: 160px; }
.wa-bubble.b2 { bottom: 18%; right: 4%; width: 140px; border-radius: 20px 20px 4px 20px; }
@media (max-width: 768px) {
