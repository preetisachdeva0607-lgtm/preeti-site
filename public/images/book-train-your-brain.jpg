<script>
const galleryItems = [
  { type:'img', caption:'Educators Felicitation — GNIOT, Greater Noida' },
  { type:'img', caption:'With Certificate at GNIOT' },
  { type:'img', caption:'At GNIOT Event' },
  { type:'img', caption:'Certificate Ceremony' },
  { type:'img', caption:'On Stage — Felicitation' },
  { type:'img', caption:'Receiving Award' },
  { type:'img', caption:'Online Parenting Session — 50+ Participants' },
  { type:'img', caption:'Learn English with Preeti — Online Zoom Class' },
  { type:'img', caption:'The Importance of Tone — Interactive Activity' },
  { type:'img', caption:'Live Session — Parenting With Preeti' },
  { type:'img', caption:'Real-Life Practice — Tone & Communication' },
  { type:'img', caption:'Online English Class — Students from Across India' },
  { type:'img', caption:'With Students — In-Person Session' },
  { type:'img', caption:'Classroom Circle — Group Learning Activity' },
  { type:'img', caption:'Interactive Learning Session' },
  { type:'img', caption:'Spoken English Tutorials — Admissions Open' },
  { type:'img', caption:'Coaching Classes — Nursery to Class 7' },
  { type:'video', src:'gallery-video.mp4', caption:'Felicitation Ceremony Video' }
];
let currentIdx = 0;
function openLightbox(idx) {
  currentIdx = idx;
  const lb = document.getElementById('lightbox');
  const content = document.getElementById('lightboxContent');
  const caption = document.getElementById('lightboxCaption');
  const item = galleryItems[idx];
  if (item.type === 'video') {
    content.innerHTML = '<video src="'+item.src+'" controls autoplay style="max-width:90vw;max-height:85vh;border-radius:10px;"></video>';
  } else {
    const imgs = document.querySelectorAll('.gallery-item img');
    content.innerHTML = '<img src="'+imgs[idx].src+'" style="max-width:90vw;max-height:85vh;border-radius:10px;">';
  }
  caption.textContent = item.caption;
  lb.classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('active');
  document.getElementById('lightboxContent').innerHTML = '';
  document.body.style.overflow = '';
}
function navLightbox(dir) {
  currentIdx = (currentIdx + dir + galleryItems.length) % galleryItems.length;
  openLightbox(currentIdx);
}
document.getElementById('lightbox').addEventListener('click', function(e) {
  if (e.target === this) closeLightbox();
});
document.addEventListener('keydown', function(e) {
  if (document.getElementById('lightbox').classList.contains('active')) {
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navLightbox(-1);
    if (e.key === 'ArrowRight') navLightbox(1);
  }
  if (e.key === 'Escape') {
    document.querySelectorAll('.blog-modal.active').forEach(m => { m.classList.remove('active'); document.body.style.overflow=''; });
  }
});
function toggleBlog(fullId, cardId) {
  var el = document.getElementById(fullId);
  var card = document.getElementById(cardId);
  if (el.classList.contains('active')) {
    el.classList.remove('active');
    card.style.maxWidth = '';
  } else {
    el.classList.add('active');
    card.style.maxWidth = '100%';
    card.style.gridColumn = '1 / -1';
    setTimeout(function(){ el.scrollIntoView({behavior:'smooth', block:'start'}); }, 100);
  }
}
</script>
<!-- Mini Quiz Script -->
<script>
const quizData = [
  {
    q: "When your child has free time, they usually prefer to:",
    opts: [
      {text: "Read books or write stories", type: "LI"},
      {text: "Build things, draw, or solve puzzles", type: "VS"},
      {text: "Play outdoors, dance, or do sports", type: "BK"},
      {text: "Listen to music or hum tunes", type: "MU"}
    ]
  },
  {
    q: "In a group activity, your child tends to:",
    opts: [
      {text: "Take charge and organize everyone", type: "IE"},
      {text: "Work quietly on their own part", type: "IA"},
      {text: "Help others and make sure everyone is included", type: "IE"},
      {text: "Notice patterns and figure out the logic", type: "LM"}
    ]
  },
  {
    q: "Your child learns best when they can:",
    opts: [
      {text: "See pictures, charts, or diagrams", type: "VS"},
      {text: "Talk about it or hear it explained", type: "LI"},
      {text: "Touch, move, or do hands-on activities", type: "BK"},
      {text: "Connect it to nature or real-world examples", type: "NA"}
    ]
  },
  {
    q: "What does your child remember most easily?",
    opts: [
      {text: "Songs, rhythms, and sounds", type: "MU"},
      {text: "Faces, places, and visual details", type: "VS"},
      {text: "Numbers, facts, and logical sequences", type: "LM"},
      {text: "How things made them feel", type: "IA"}
    ]
  },
  {
    q: "Which activity would excite your child the most?",
    opts: [
      {text: "A nature walk or gardening project", type: "NA"},
      {text: "A debate or storytelling competition", type: "LI"},
      {text: "A math olympiad or science experiment", type: "LM"},
      {text: "A drama performance or team sport", type: "BK"}
    ]
  }
];

const intellTypes = {
  LI: {name:"Linguistic Intelligence",emoji:"📝",desc:"Your child has a natural gift with words! They likely enjoy reading, writing, and expressing themselves verbally. They could excel in writing, journalism, law, or teaching."},
  LM: {name:"Logical-Mathematical Intelligence",emoji:"🔢",desc:"Your child thinks in patterns and logic! They love problem-solving, numbers, and figuring out how things work. Great potential in science, engineering, coding, or finance."},
  VS: {name:"Visual-Spatial Intelligence",emoji:"🎨",desc:"Your child thinks in pictures! They're great at visualizing, drawing, and understanding spatial relationships. They could shine in art, architecture, design, or photography."},
  BK: {name:"Bodily-Kinesthetic Intelligence",emoji:"⚽",desc:"Your child learns through movement and touch! They're physically coordinated and love hands-on activities. Great potential in sports, dance, surgery, or craftsmanship."},
  MU: {name:"Musical Intelligence",emoji:"🎵",desc:"Your child has a natural ear for music! They're sensitive to rhythm, melody, and sounds. They could excel in music, sound engineering, or any field requiring auditory skills."},
  IE: {name:"Interpersonal Intelligence",emoji:"🤝",desc:"Your child is a natural people-person! They understand others' feelings and motivations. Great potential in counselling, leadership, teaching, or business."},
  IA: {name:"Intrapersonal Intelligence",emoji:"🧘",desc:"Your child has deep self-awareness! They understand their own emotions and motivations well. They could excel in psychology, philosophy, writing, or entrepreneurship."},
  NA: {name:"Naturalistic Intelligence",emoji:"🌿",desc:"Your child connects deeply with nature! They notice patterns in the natural world and love animals and plants. Great potential in biology, environmental science, or agriculture."}
};

let quizStep=0, quizScores={};
function startQuiz(){
  document.getElementById('quiz-intro').style.display='none';
  document.getElementById('quiz-questions').style.display='block';
  quizScores={LI:0,LM:0,VS:0,BK:0,MU:0,IE:0,IA:0,NA:0};
  quizStep=0;
  showQuestion();
}
function showQuestion(){
  const d=quizData[quizStep];
  let h=`<p style="font-size:0.9em;color:var(--primary);font-weight:600;margin-bottom:8px;">Question ${quizStep+1} of 5</p>`;
  h+=`<p style="font-size:1.15em;font-weight:600;margin-bottom:20px;color:var(--text);">${d.q}</p>`;
  d.opts.forEach((o,i)=>{
    h+=`<div onclick="pickAnswer('${o.type}',this)" style="padding:14px 18px;margin-bottom:10px;border:2px solid #e8e0f0;border-radius:12px;cursor:pointer;transition:all 0.2s;font-size:1em;" onmouseover="this.style.borderColor='var(--primary)';this.style.background='#f9f5ff'" onmouseout="if(!this.classList.contains('picked')){this.style.borderColor='#e8e0f0';this.style.background='#fff'}">${o.text}</div>`;
  });
  document.getElementById('quiz-q').innerHTML=h;
  document.getElementById('quiz-bar').style.width=((quizStep+1)*20)+'%';
}
function pickAnswer(type,el){
  if(el.classList.contains('picked'))return;
  el.classList.add('picked');
  el.style.borderColor='var(--primary)';
  el.style.background='#f0e8ff';
  quizScores[type]++;
  setTimeout(()=>{
    quizStep++;
    if(quizStep<5){showQuestion();}
    else{showResult();}
  },400);
}
function showResult(){
  document.getElementById('quiz-questions').style.display='none';
  document.getElementById('quiz-result').style.display='block';
  let top=Object.entries(quizScores).sort((a,b)=>b[1]-a[1])[0][0];
  const t=intellTypes[top];
  let h=`<div style="font-size:50px;margin-bottom:10px;">${t.emoji}</div>`;
  h+=`<h3 style="color:var(--primary);font-size:1.5em;margin-bottom:8px;">${t.name}</h3>`;
  h+=`<p style="color:var(--text-light);font-size:1em;margin-bottom:25px;line-height:1.6;">${t.desc}</p>`;
  h+=`<div style="background:linear-gradient(135deg,#E6FFFA,#E6FFFA);border-radius:12px;padding:20px;margin-bottom:25px;">`;
  h+=`<p style="font-weight:700;color:var(--primary);margin-bottom:8px;">🎯 Want the Complete CogniPrint Profile?</p>`;
  h+=`<p style="font-size:0.95em;color:var(--text-light);">This mini-quiz covers just the surface! The full <strong>CogniPrint Analysis</strong> maps all 8 intelligences with 40+ questions, gives detailed career guidance, study strategies, and a personalized report.</p>`;
  h+=`</div>`;
  h+=`<a href="https://wa.me/918920038298?text=Hi%20Preeti!%20I%20took%20the%20mini%20CogniPrint%20quiz%20and%20got%20${encodeURIComponent(t.name)}.%20I%27d%20like%20to%20book%20the%20full%20assessment!" target="_blank" style="display:inline-block;padding:14px 35px;font-size:1.05em;font-weight:700;border:none;border-radius:50px;background:var(--primary);color:#fff;text-decoration:none;box-shadow:0 4px 15px rgba(13,148,136,0.3);transition:all 0.3s;">📞 Book Full Assessment on WhatsApp</a>`;
  h+=`<br><button onclick="document.getElementById('quiz-result').style.display='none';document.getElementById('quiz-intro').style.display='block';" style="margin-top:15px;padding:10px 25px;border:2px solid var(--primary);border-radius:50px;background:transparent;color:var(--primary);cursor:pointer;font-weight:600;font-size:0.95em;">↺ Take Quiz Again</button>`;
  document.getElementById('quiz-result').innerHTML=h;
}
</script>

<!-- Scroll Animations & Parallax -->
<script>
// Intersection Observer for scroll animations
document.addEventListener('DOMContentLoaded', function() {
  // Add scroll-animate class to elements
  const animateSelectors = [
    '.section-header',
    '.service-card',
    '.award-item',
    '.cert-item',
    '.gallery-item',
    '.blog-card',
    '.testimonial-card',
    '.stat',
    '.about-text',
    '.about-grid > div:first-child',
    '.book-cover',
    '.book-info',
    '.contact-info',
    '.contact-form'
  ];

  animateSelectors.forEach(function(sel) {
    document.querySelectorAll(sel).forEach(function(el, i) {
      el.classList.add('scroll-animate');
      el.style.transitionDelay = (i % 4) * 0.1 + 's';
    });
  });

  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.scroll-animate, .scroll-animate-left, .scroll-animate-right').forEach(function(el) {
    observer.observe(el);
  });

  // Parallax effect on hero
  var hero = document.getElementById('hero-parallax');
  if (hero) {
    window.addEventListener('scroll', function() {
      var scrolled = window.pageYOffset;
      if (scrolled < window.innerHeight) {
        hero.style.backgroundPositionY = (scrolled * 0.3) + 'px';
        var shapes = hero.querySelector('.hero-shapes');
        if (shapes) shapes.style.transform = 'translateY(' + (scrolled * 0.15) + 'px)';
      }
    }, { passive: true });
  }
});
</script>

